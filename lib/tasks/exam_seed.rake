# An exam with students part-way through it, so the exam session page and the
# room map can be tried by hand without logging in from a dozen browsers.
#
# Runs on its own and is safe to re-run: it deletes its previous students first,
# and the names are drawn from a fixed seed, so a re-run reproduces them.
#
#   bin/rails dev:exam_seed                      # 30 students, nobody placed
#   bin/rails dev:exam_seed STUDENTS=24 PLACED=20
#   bin/rails dev:exam_seed LATE=5 SCHEDULE=Herfst
#
# It deliberately does not switch exam mode on: that stays something you do
# yourself at /admin/exams, because it locks the whole site down.

module ExamSeed

    MAIL_PREFIX = "exam-seed"
    PSET_NAME = "exam-seed-exam"

    module_function

    # Borrowed from the overview seed, so the two sets of generated students
    # look like they come from the same course. Rake loads every file in
    # lib/tasks, so that module is always around by the time a task runs.
    def student_name(n)
        OverviewSeed.student_name(n)
    end

end

namespace :dev do
    desc "Create an exam with students taking it, for trying the room map by hand"
    task exam_seed: :environment do
        abort "dev:exam_seed only runs in development" unless Rails.env.development?

        student_count = Integer(ENV.fetch("STUDENTS", 30))
        late_count    = Integer(ENV.fetch("LATE", 3))
        placed_count  = Integer(ENV.fetch("PLACED", 0))

        schedule =
            if ENV["SCHEDULE"].present?
                Schedule.find_by!(name: ENV["SCHEDULE"])
            else
                Schedule.default
            end

        if schedule.blank?
            abort "No default schedule (none has self_register set). " \
                  "Pass SCHEDULE=\"<name>\". Known: #{Schedule.pluck(:name).inspect}"
        end

        require "digest"
        seed = Digest::SHA256.hexdigest("exam-seed:#{schedule.name}").to_i(16) % (2**48)
        rng = Random.new(seed)
        puts "Schedule: #{schedule.name} (seed #{seed})"

        # The exam itself. A pset with exam config is what Course::Tools would
        # have produced from a submit.yml with exam: true.
        pset = Pset.where(name: ExamSeed::PSET_NAME).first_or_initialize
        pset.config = (pset.config || {}).merge("exam" => true)
        pset.description = "Generated by dev:exam_seed"
        pset.save!

        exam = Exam.where(pset: pset).first_or_initialize
        exam.eval_code = "SEED"
        exam.locked = true
        exam.save!

        # Previous run's students, and with them their submits.
        old = User.where("mail LIKE ?", "#{ExamSeed::MAIL_PREFIX}-%@example.test")
        puts "Removing #{old.count} students from a previous run" if old.any?
        old.destroy_all

        total = student_count + late_count
        submits = []

        (1..total).each do |n|
            late = n > student_count

            student = User.create!(
                mail: format("%s-%02d@example.test", ExamSeed::MAIL_PREFIX, n),
                name: ExamSeed.student_name(n),
                role: :student,
                schedule: schedule,
                status: :active,
                pin: rng.rand(1111..9999)
            )

            # one in six has no IP yet, so the "no IP" state is visible too
            unless rng.rand(6).zero?
                student.update!(last_known_ip: "10.0.0.#{n}")
            end

            submitted_at =
                if late
                    rng.rand(6..12).hours.ago
                else
                    # spread over the last hour, so the freshness dots on the
                    # tiles show green, amber and red side by side
                    rng.rand(0..3600).seconds.ago
                end

            submit = Submit.create!(
                user: student,
                pset: pset,
                submitted_at: submitted_at,
                exam_code: SecureRandom.hex(32),
                locked: !late && rng.rand(10).zero?
            )

            submits << submit unless late
        end

        # Optionally seat the first few, so the Place and Overview phases can be
        # opened without clicking through everybody first.
        if placed_count.positive?
            exam.room = { "rows" => 6, "cols" => 6, "stagger" => true, "disabled" => [], "phase" => "place" }
            exam.save!

            seats = exam.enabled_seats
            submits.first([ placed_count, seats.size ].min).each_with_index do |submit, index|
                submit.update!(seat: seats[index])
            end
            puts "Placed #{[ placed_count, seats.size ].min} students in a 6x6 room"
        end

        puts
        puts "Exam:             #{exam.name} (#{exam.eval_code})"
        puts "Students taking:  #{student_count}"
        puts "Older than 5h:    #{late_count}"
        puts
        puts "Room map:         /admin/exams/#{exam.id}?view=room"
        puts "Start exam mode:  /admin/exams  (pick \"#{exam.name_with_code}\")"
        puts "Access code:      #{Settings.exam_code.presence || '(not set yet)'}"
        puts "Example PIN:      #{User.find_by('mail LIKE ?', "#{ExamSeed::MAIL_PREFIX}-01@%")&.pin}"
    end
end
