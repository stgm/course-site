<table class="table">
    <thead>
        <tr>
            <th>Grade type</th>
            <th>Pending</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <% @final_grade_names.each do |name| %>
        <tr>
            <td><%= name %></td>
            <td><%= @pending_counts[name] %></td>
            <td><%= link_to "Review", admin_final_grade_path(name), class: 'btn btn-outline-primary btn-sm' %></td>
        </tr>
        <% end %>
    </tbody>
</table>
