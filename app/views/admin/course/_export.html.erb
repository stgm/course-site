<%= toggle_setting_form('export_nap_final_grades', 'Export NAP for empty final grades') %>

<%= link_to 'Export grades XSLX', admin_course_export_grades_path(format: 'xlsx'), class: 'btn btn-outline-primary', data: { turbo: false } %>
<%= link_to 'Export grades overview', admin_course_export_grades_path(format: 'html'), class: 'btn btn-outline-primary', data: { turbo: false } %>
<%= link_to 'Download course archive', admin_course_archive_path, class: 'btn btn-primary', data: { turbo: false } %>

<div class="mt-2">
    <small class="text-muted">The archive is a zip with the grades (XLSX and PDF) and a syllabus and announcements PDF per schedule.</small>
    <% unless Settings.registration_phase == 'archival' %>
    <br><small class="text-warning">The course is not in archival phase yet — set it there first, so the data can no longer change.</small>
    <% end %>
</div>
