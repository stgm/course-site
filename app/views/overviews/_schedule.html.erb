<h5 class="schedule-header">
  <%= schedule.name %>
  <% if @selected_schedule.blank? %>
  <%= render partial: 'schedule_operations', locals: { schedule: schedule } %>
  <% end %>
</h5>

<% schedule_overview_config = schedule.grading_config.overview %>
<% git_repos_present = GitRepo.any? %>
<% groups = schedule.grouped_users(params[:status], @accessible_schedules, @accessible_groups) %>

<table id="grade-table" class="table table-sm table-borderless table-responsive" data-controller="grade-tooltip module-collapse grade-cell edit-in-place"
       data-module-collapse-schedule-value="<%= schedule.slug %>"
       data-module-collapse-url-value="<%= profile_collapsed_modules_path %>"
       data-module-collapse-collapsed-value="<%= current_user.collapsed_modules(schedule).to_json %>">

    <%# The table is laid out with fixed column widths, so these widths are the
        authoritative ones: a width on a cell further down is ignored. The
        module columns carry data-module as well, so collapsing a module
        narrows the column itself. %>
    <colgroup>
        <col class="col-name">
        <col class="col-bar">
        <% if git_repos_present %>
        <col class="col-git">
        <% end %>
        <% schedule_overview_config.each do |name, flag, psets| %>
            <% if flag == :blocks %>
            <col data-module="<%= name %>" class="module-block-col">
            <% else %>
                <% psets.each do |pset, weight| %>
                <col data-module="<%= name %>" class="<%= 'grade-col-pf' if pset.grading_config(schedule).to_h['type'] == 'pass' %>">
                <% end %>
            <% end %>
        <% end %>
    </colgroup>


    <%# bulk ops header row %>
    <% if current_user.admin? %>
    <tr class="sticky-1">
        <th>&nbsp;</th>
        <th>&nbsp;</th>

        <% if git_repos_present %>
        <th></th>
        <% end %>

        <% schedule_overview_config.each_with_index do |(name, flag, psets), module_index| %>
            <% if flag == :blocks %>
                <th data-module="<%= name %>" class="<%= 'module-tint' if module_index.odd? %>"></th>
            <% else %>
                <% psets.each_with_index do |(pset, weight), index| %>
                <th data-module="<%= name %>" class="<%= 'module-tint' if module_index.odd? %>">
                    <div class="dropdown">
                        <button id="overviewsTableColumnDropdown" class="btn w-100 px-0 py-0 btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="overviewsTableColumnDropdown">
                            <li><h6 class="dropdown-header"><%= pset.name %></h6></li>
                            <li>
                                <%= link_to "Publish all", publish_schedule_grades_path(schedule_slug: schedule.slug, pset_id: pset.id), method: :post, data: { confirm: "Publish all grades for this assignment?" }, class: 'small dropdown-item' %>
                            </li>
                            <li>
                                <% if pset.submit_config["check"].present? %>
                                    <%= link_to "Run checks for all", recheck_schedule_submits_path(schedule_slug: schedule.slug, pset_id: pset.id), method: :post, data: { confirm: "Run checks for all submits for this assignment?" }, class: 'small dropdown-item' %>
                                <% else %>
                                    <span class="small dropdown-item disabled text-muted">Run checks for all (no checks)</span>
                                <% end %>
                            </li>
                            <hr>
                            <% groups.each do |group, user_list| %>
                            <% if group %>
                            <%= link_to "Unpublish for #{group.name}", reopen_schedule_grades_path(schedule_slug: schedule.slug, pset_id: pset.id, group_id: group.id), method: :post, data: { confirm: "Re-open all grades for this assignment for this group?" }, class: 'small dropdown-item' %>
                            <% end %>
                            <% end %>
                        </ul>
                    </div>
                </th>
                <% end %>
            <% end %>
        <% end %>
    </tr>
    <% end %>

    <%# assignment groups header row %>
    <tr class="sticky-2">
        <th>&nbsp;</th>
        <th>&nbsp;</th>

        <% if git_repos_present %>
        <th>git</th>
        <% end %>

        <% schedule_overview_config.each_with_index do |(group, flag, psets), module_index| %>
            <% if flag == :blocks %>
            <th data-module="<%= group %>" data-action="click->module-collapse#toggle"
                class="module-toggle <%= 'module-tint' if module_index.odd? %>">
                <span class="module-header"><%= group.titleize.split.last %></span>
            </th>
            <% else %>
            <th colspan="<%= psets.length %>" data-module="<%= group %>"
                data-action="click->module-collapse#toggle"
                class="module-toggle <%= 'module-tint' if module_index.odd? %>">
                <span class="module-header"><%= group.humanize %></span>
            </th>
            <% end %>
        <% end %>
    </tr>

    <%# actual students, in groups %>
    <% groups.each do |group, user_list| %>
    <tr>
        <th class="py-2" colspan="2">
            <% if group %>
            <%= group.name %> &ndash;
            <%= group.grader_names %>
            <% else %>
            Groupless
            <% end %>
            (<%= user_list.size %>)
        </th>
        <% if git_repos_present %>
            <th>
                <%= link_to bootstrap_icon('git'), group.git_repos.first.url, target: '_new' if group&.git_repos&.any? %>
            </th>
        <% end %>
        <%# empty cells so the module bands run through the group header row %>
        <% schedule_overview_config.each_with_index do |(name, flag, psets), module_index| %>
        <th colspan="<%= flag == :blocks ? 1 : psets.length %>" data-module="<%= name %>"
            class="<%= 'module-tint' if module_index.odd? %>"></th>
        <% end %>
    </tr>
    <%# One multi-read for the whole group instead of a cache lookup per row.
        The row is cached per user and per viewer, since it shows more to
        seniors, and expires within six hours through the time bucket. %>
    <%= render partial: 'user_row',
               collection: user_list,
               as: :user,
               cached: ->(user) { [ user, current_user, Time.current.to_i / 6.hours.to_i ] },
               locals: { schedule: schedule,
                         schedule_overview_config: schedule_overview_config,
                         git_repos_present: git_repos_present } %>
    <% end %>
</table>
