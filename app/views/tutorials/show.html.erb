<section class="markdown" id="exams-content">
    <h1><%= @tutorial.name.titleize %> <code><%= @tutorial.pin %></code></h1>
    <p><%= link_to t('tutorial.back'), tutorials_path %></p>

    <% if flash[:notice] %><p class="text-muted"><%= flash[:notice] %></p><% end %>

    <%# Links and buttons inside leave the frame; frame_poll reloads it while the page is open. %>
    <%= turbo_frame_tag "participants", target: "_top" do %>
    <div data-controller="frame-poll" data-frame-poll-url-value="<%= tutorial_path(@tutorial) %>" data-frame-poll-interval-value="5">
        <%= render "participants" %>
    </div>
    <% end %>
</section>
